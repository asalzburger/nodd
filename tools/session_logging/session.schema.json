{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nODD curated session record v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^SESSION-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    },
    "collection": {
      "type": "string",
      "enum": [
        "retrospective",
        "contemporaneous"
      ]
    },
    "completeness": {
      "type": "string",
      "enum": [
        "partial",
        "complete"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "client": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "thread_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version",
        "thread_id"
      ],
      "additionalProperties": false
    },
    "git": {
      "type": "object",
      "properties": {
        "start_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "initial_changes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "result_commits": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "start_commit",
        "branch",
        "initial_changes",
        "result_commits",
        "changed_files"
      ],
      "additionalProperties": false
    },
    "work": {
      "type": "object",
      "properties": {
        "milestone": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "related_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "milestone",
        "components",
        "related_ids"
      ],
      "additionalProperties": false
    },
    "narrative": {
      "type": "string",
      "minLength": 1
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "tool",
              "skill"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "calls": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "failures": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "duration_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "name",
          "version",
          "calls",
          "failures",
          "duration_seconds",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "usage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "client_thread_id": {
            "type": "string",
            "minLength": 1
          },
          "turn_id": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "cached_input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "reasoning_output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "total_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "client_thread_id",
          "turn_id",
          "model",
          "source",
          "limitations",
          "input_tokens",
          "cached_input_tokens",
          "output_tokens",
          "reasoning_output_tokens",
          "total_tokens"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NOT RUN"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "result": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "command",
          "status",
          "exit_code",
          "result"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "session_id",
    "title",
    "recorded_at",
    "started_at",
    "ended_at",
    "status",
    "collection",
    "completeness",
    "limitations",
    "client",
    "git",
    "work",
    "narrative",
    "activities",
    "usage",
    "checks"
  ],
  "additionalProperties": false
}
