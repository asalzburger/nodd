# Mac stuff
.DS_Store

# Keep source instructions in Git; downloaded binaries stay local.
/reference/pdfs/*.pdf
/reference/pdfs/*.part

# Reproducible reference extraction environment, text and page images.
/reference/cache/
/tools/reference_reading/__pycache__/

# Generated token dashboard and Python bytecode.
/_site/
/tools/token_usage/__pycache__/
/tools/project_records/__pycache__/
/tools/tracker_layout/__pycache__/
/tools/module_layout/__pycache__/

# Local DD4hep builds and exported compact descriptions.
/build/
/tools/pixel_barrel_dd4hep/__pycache__/
/tools/nodehammer/__pycache__/

# Generated Python bytecode in any tool directory.
__pycache__/

# Local software build products and task diffs.
/software/build/
/_work_diffs/
**/__pycache__/

# IdRes regenerates R plotting helpers; retain geometry and numerical evidence.
/docs/validation/MUON-001/idres/*.R
