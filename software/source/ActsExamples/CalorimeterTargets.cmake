# Optional migrated calorimeter capabilities use the existing Spack libraries.
option(NODD_BUILD_CALORIMETER "Build nODD calorimeter algorithms and controls" ON)
option(NODD_BUILD_CALORIMETER_JETS "Build FastJet reconstruction" ON)
option(NODD_BUILD_CALORIMETER_EDM4HEP "Build EDM4hep hit/cluster/jet persistence" ON)
# Keep standalone header checks in the build tree even though local targets
# are included in the ACTS directory scope.
function(nodd_compile_headers target)
  if(NOT ACTS_COMPILE_HEADERS)
    return()
  endif()
  cmake_parse_arguments(ARG "" "" "GLOB" ${ARGN})
  file(GLOB_RECURSE _headers CONFIGURE_DEPENDS ${ARG_GLOB})
  set(_sources "")
  foreach(_header IN LISTS _headers)
    string(SHA1 _key "${_header}")
    set(_source "${CMAKE_BINARY_DIR}/nodd-header-checks/${target}/${_key}.cpp")
    file(GENERATE OUTPUT "${_source}" CONTENT "#include \"${_header}\"\n")
    list(APPEND _sources "${_source}")
  endforeach()
  add_library(Acts${target}_HEADERS OBJECT EXCLUDE_FROM_ALL ${_sources})
  target_link_libraries(Acts${target}_HEADERS PRIVATE Acts::${target})
endfunction()

function(nodd_include_component path)
  set(NODD_COMPONENT_SOURCE_DIR "${path}")
  include("${path}/CMakeLists.txt")
endfunction()
if(NODD_BUILD_CALORIMETER)
  nodd_include_component("${NODD_SOFTWARE_ROOT}/source/EDM")
  nodd_include_component("${NODD_SOFTWARE_ROOT}/source/Calorimeter")
  nodd_include_component("${NODD_ACTS_EXAMPLES_SOURCE}/Calorimeter")
  set(_nodd_calo_targets ActsExampleCalorimeter)
  if(NODD_BUILD_CALORIMETER_JETS)
    find_package(FastJet CONFIG QUIET)
    if(NOT TARGET FastJet::FastJet)
      find_package(FastJet REQUIRED)
    endif()
    nodd_include_component("${NODD_SOFTWARE_ROOT}/source/Calorimeter/Jets")
    nodd_include_component("${NODD_ACTS_EXAMPLES_SOURCE}/Calorimeter/Jets")
    list(APPEND _nodd_calo_targets ActsExampleCalorimeterJets)
  endif()
  if(NODD_BUILD_CALORIMETER_EDM4HEP)
    if(NOT TARGET Acts::ExamplesIoPodio)
      message(FATAL_ERROR "EDM4hep persistence needs ACTS_BUILD_EXAMPLES_PODIO=ON")
    endif()
    nodd_include_component("${NODD_ACTS_EXAMPLES_SOURCE}/Calorimeter/EDM4hep")
    list(APPEND _nodd_calo_targets ActsExampleCalorimeterEDM4hep)
    if(NODD_BUILD_CALORIMETER_JETS)
      list(APPEND _nodd_calo_targets ActsExampleCalorimeterJetsEDM4hep)
    endif()
  endif()
  if(ACTS_BUILD_UNITTESTS)
    # Define local tests with absolute source paths; retain the upstream controls.
    nodd_include_component("${NODD_SOFTWARE_ROOT}/source/Calorimeter/tests")
    list(APPEND _nodd_calo_targets ActsUnitTestCalorimeterResponse ActsUnitTestCalorimeterClustering)
    if(NODD_BUILD_CALORIMETER_JETS)
      list(APPEND _nodd_calo_targets ActsUnitTestCalorimeterJets)
    endif()
    if(NODD_BUILD_CALORIMETER_EDM4HEP)
      list(APPEND _nodd_calo_targets ActsUnitTestCalorimeterEDM4hep ActsUnitTestCalorimeterEDM4hepReconstruction)
      if(NODD_BUILD_CALORIMETER_JETS)
        list(APPEND _nodd_calo_targets ActsUnitTestCalorimeterEDM4hepJets)
      endif()
    endif()
  endif()
  add_custom_target(nodd-calorimeter DEPENDS ${_nodd_calo_targets})
endif()
